            "description": {
              "content": "Returns transaction/receipt records for a hotel over a date range, including a transaction time for each record. Since API v2.8.0.2, reservation-linked records also carry a ReservationUniqueID array of channel-partner confirmation numbers (ShortCode, Name, ConfirmationNumber) for integrations such as Booking.com, Expedia, SynXis, and TravelClick.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "hotels",
                ":hotelId",
                "statistics",
                "receipts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
